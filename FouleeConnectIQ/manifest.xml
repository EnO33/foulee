<?xml version="1.0"?>
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        entry="FouleeApp"
        id="859c7300a91149fdb6ce7e4453bfe59d"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="5.0.0"
        name="@Strings.AppName"
        type="watch-app">

        <!-- Device matrix: every id below exists in the installed Connect IQ
             device profiles, supports background services and runs CIQ 5.0.0
             or later, so every device gets the glance. See README.md. -->
        <iq:products>
            <iq:product id="fenix843mm"/>
            <iq:product id="fr165"/>
            <iq:product id="venu2"/>
            <iq:product id="venusq2"/>
            <iq:product id="vivoactive5"/>
        </iq:products>

        <!-- minApiLevel 5.0.0: the floor of the device matrix. The code itself
             needs 3.2.0 (Application.Storage written from the background),
             4.0.0 (a watch-app glance) and 3.4.0 (WatchUi.ViewLoop). -->

        <!-- ActivityMonitor needs no permission. Background is required by the
             temporal event, Communications by the transmit to the phone. -->
        <iq:permissions>
            <iq:uses-permission id="Background"/>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="Fit"/>
            <iq:uses-permission id="Positioning"/>
            <iq:uses-permission id="Sensor"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>eng</iq:language>
            <iq:language>fre</iq:language>
        </iq:languages>

        <iq:barrels/>
    </iq:application>
</iq:manifest>
