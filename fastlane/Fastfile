default_platform(:ios)

# The App Store Connect key of docs/RELEASE.md step 6, from the environment.
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    in_house: false
  )
end

# Foulée ships from CI only: `git tag v1.2.3 && git push --tags` runs the
# release workflow, which calls `fastlane release`. Everything is driven by
# environment variables set in .github/workflows/release.yml — see
# docs/RELEASE.md for the secrets each one maps to.
platform :ios do
  desc "Build the iOS app (with its extensions + Watch app) and upload to TestFlight"
  lane :release do
    # Creates and unlocks a throwaway keychain on CI (no-op locally).
    setup_ci

    api_key = asc_api_key

    # Import the distribution certificate (.p12) into the CI keychain. The
    # App Store provisioning profiles themselves are created/refreshed by
    # Xcode via the API key (`-allowProvisioningUpdates` below), so we don't
    # have to manage one profile per target by hand.
    import_certificate(
      certificate_path: ENV.fetch("DIST_CERT_PATH"),
      certificate_password: ENV.fetch("DIST_CERT_PASSWORD"),
      keychain_name: ENV.fetch("MATCH_KEYCHAIN_NAME", "fastlane_tmp_keychain"),
      keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD", "")
    )

    # Also import a development certificate when one is provided. The CI
    # keychain is thrown away each run, so without a dev identity present,
    # `-allowProvisioningUpdates` mints a brand-new "Apple Development"
    # certificate on every release — they pile up and eventually hit the
    # account's certificate limit. Importing a persistent one lets cloud
    # signing reuse it. Optional: skipped until the DEV_CERT_P12 secret is set.
    dev_cert_path = ENV["DEV_CERT_PATH"]
    if dev_cert_path && File.exist?(dev_cert_path)
      import_certificate(
        certificate_path: dev_cert_path,
        certificate_password: ENV["DEV_CERT_PASSWORD"] || "",
        keychain_name: ENV.fetch("MATCH_KEYCHAIN_NAME", "fastlane_tmp_keychain"),
        keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD", "")
      )
    end

    build_app(
      workspace: "Foulee.xcworkspace",
      scheme: "Foulee",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "Foulee.ipa",
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath", ENV.fetch("ASC_KEY_PATH"),
        "-authenticationKeyID", ENV.fetch("ASC_KEY_ID"),
        "-authenticationKeyIssuerID", ENV.fetch("ASC_ISSUER_ID"),
        "MARKETING_VERSION=#{ENV.fetch('FOULEE_MARKETING_VERSION')}",
        "CURRENT_PROJECT_VERSION=#{ENV.fetch('FOULEE_BUILD_NUMBER')}"
      ].join(" "),
      export_options: {
        signingStyle: "automatic",
        teamID: ENV.fetch("DEVELOPMENT_TEAM")
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end

  # The store listing is versioned in fastlane/metadata (issue #581) and
  # published by the « Store listing » workflow: no binary, no screenshots,
  # never submitted for review. The version is the one being prepared; deliver
  # creates it when App Store Connect has none to edit yet.
  desc "Publish the App Store listing in fastlane/metadata to the version being prepared"
  lane :metadata do
    api_key = asc_api_key

    deliver(
      api_key: api_key,
      app_version: ENV.fetch("FOULEE_MARKETING_VERSION"),
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false,
      # No HTML preview to confirm on CI.
      force: true
    )
  end

  # The boards composed by tools/compose_appstore_screenshots.swift (issue
  # #582), uploaded in place of the version's screenshots: no binary, no
  # metadata, never submitted for review. deliver tells the iPhone 6.9", iPad
  # 13" and Apple Watch boards apart by their size and orders each set by file
  # name, so the family prefix keeps the iPhone and iPad boards — same capture
  # names — from overwriting each other, and the number keeps the store order.
  # One folder per language: the French boards, and the English ones the
  # composer writes under en-US/ (issue #592).
  desc "Upload the composed App Store boards to the version being prepared"
  lane :screenshots do
    root = File.expand_path("../appstore-screenshots", __dir__)
    screenshots = File.expand_path("screenshots", __dir__)
    FileUtils.rm_rf(screenshots)
    { "fr-FR" => root, "en-US" => File.join(root, "en-US") }.each do |locale, boards|
      staging = File.join(screenshots, locale)
      FileUtils.mkdir_p(staging)
      { "iphone-6.9" => "iphone", "ipad-13" => "ipad", "watch" => nil }.each do |family, prefix|
        files = Dir[File.join(boards, family, "*.png")].sort
        UI.user_error!("No boards in #{File.join(boards, family)}: capture and compose first") if files.empty?
        files.each do |file|
          name = prefix ? "#{prefix}-#{File.basename(file)}" : File.basename(file)
          FileUtils.cp(file, File.join(staging, name))
        end
      end
    end

    api_key = asc_api_key

    deliver(
      api_key: api_key,
      app_version: ENV.fetch("FOULEE_MARKETING_VERSION"),
      screenshots_path: screenshots,
      overwrite_screenshots: true,
      skip_binary_upload: true,
      skip_metadata: true,
      submit_for_review: false,
      # No HTML preview to confirm on CI.
      force: true
    )
  end
end
